---
import ThemeToggle from './ThemeToggle.astro'
import LangToggle from './LangToggle.astro'
---
<footer class="px-6 py-10">
  <div class="max-w-5xl mx-auto">
    <div class="text-border-default text-xs font-mono select-none mb-6" aria-hidden="true">---</div>
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-center gap-5">
        <a
          href="/app"
          class="text-text-secondary hover:text-accent transition-colors text-sm font-medium"
          data-i18n="footer.openApp"
        >
          Open App
        </a>
        <a
          href="https://github.com/wake/tmux-box"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-accent transition-colors text-sm"
        >
          GitHub
        </a>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-text-muted text-xs font-mono">
          <span data-i18n="footer.version">Version</span> 1.0.0-alpha.37
        </span>
        <ThemeToggle />
        <LangToggle />
      </div>
    </div>
  </div>
</footer>
