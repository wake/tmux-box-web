---
const images = [
  {
    src: '/screenshots/demo-connected.png',
    alt: 'tmux-box connected — multi-tab terminal with session panel and active connections',
    captionKey: 'screenshots.connected.caption',
    captionDefault: 'Connected — multi-tab terminal with session panel and active connections across hosts.',
  },
  {
    src: '/screenshots/demo-disconnected.png',
    alt: 'tmux-box reconnecting — automatic session recovery after connection drop',
    captionKey: 'screenshots.disconnected.caption',
    captionDefault: 'Reconnecting — automatic session recovery after connection drop. No work lost.',
  },
]
---
<section class="px-6 py-20 max-w-5xl mx-auto">
  <h2 class="text-2xl font-bold mb-10" data-i18n="screenshots.title">See It in Action</h2>
  <div class="space-y-10">
    {images.map((img) => (
      <figure>
        <img
          src={img.src}
          alt={img.alt}
          class="rounded border border-border-default shadow-lg max-w-full"
          loading="lazy"
        />
        <figcaption class="mt-3 text-text-muted text-xs font-mono" data-i18n={img.captionKey}>
          {img.captionDefault}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
